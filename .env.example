# Postgres connection string (required)
DATABASE_URL=postgres://user:pass@localhost:5432/kulee?sslmode=disable

# Listen address for the API server
LISTEN_ADDR=:8080

# Number of worker goroutines in the pool
WORKER_COUNT=4

# How long a claim lease lasts before expiry (seconds)
LEASE_DURATION_SECONDS=30

# Max time to wait for in-flight jobs on SIGTERM (seconds)
SHUTDOWN_DRAIN_SECONDS=60

# How often the reaper sweeps expired leases (seconds)
REAPER_INTERVAL_SECONDS=5

# Seconds of waiting = 1 effective priority point
AGING_DIVISOR_SECONDS=600

# Global max retry attempts per job
MAX_ATTEMPTS=5

# Base delay for exponential backoff (milliseconds)
RETRY_BASE_MS=1000

# Maximum backoff delay (milliseconds)
RETRY_CAP_MS=60000

# Sliding window for throughput/failure rate stats (minutes)
STATS_WINDOW_MINUTES=5
